# Backend Configuration
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/cupping-room
# For MongoDB Atlas cloud database, use:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cupping-room

# JWT Secret (change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-12345

# Email Configuration (optional - for booking confirmations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@thecuppingroom.com

# Admin First-Time Setup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@thecuppingroom.com
